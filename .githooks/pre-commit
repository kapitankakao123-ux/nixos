#!/usr/bin/env bash
# Не даёт закоммитить незавершённое слияние.
#
# Ровно это и случилось 2026-09-13: при объединении веток маркеры конфликта
# уехали в коммит, и master перестал собираться вообще. git status при этом
# показывал «clean» — ошибка молчаливая.
#
# Включается один раз на каждой машине:
#   git config core.hooksPath .githooks

set -u
fail=0

# git diff --check находит и маркеры конфликта, и мусорные пробелы.
# Останавливаем ТОЛЬКО из-за маркеров: пробелы — повод предупредить, не более.
check=$(git diff --cached --check || true)
if [ -n "$check" ]; then
  echo "$check" >&2
  if echo "$check" | grep -q 'conflict marker'; then
    echo "ОСТАНОВЛЕНО: в изменениях маркеры конфликта." >&2
    fail=1
  else
    echo "(предупреждение о пробелах — коммит не блокирую)" >&2
  fi
fi

# Отдельная проверка на случай, если файл добавлен целиком и diff его не ловит.
if git diff --cached --name-only --diff-filter=ACM -z \
   | xargs -0 -r grep -lE '^(<<<<<<< |>>>>>>> |={7}$)' 2>/dev/null | grep .; then
  echo "ОСТАНОВЛЕНО: в файлах выше остались маркеры конфликта." >&2
  fail=1
fi

if [ -e "$(git rev-parse --git-dir)/MERGE_HEAD" ]; then
  echo "Внимание: слияние ещё не завершено — проверь, что всё разрешено." >&2
fi

[ "$fail" = 0 ] || {
  echo >&2
  echo "Чинить так: открыть файлы, убрать <<<<<<< ======= >>>>>>>," >&2
  echo "оставить нужный вариант, затем git add и коммит заново." >&2
  exit 1
}
