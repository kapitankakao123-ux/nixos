// ! AUTO-GENERATED BY dmsThemeSync — DO NOT EDIT !
// ! Cursor, Qt platform theme and border override managed by the DMS Theme Sync plugin. !
environment {
    XCURSOR_THEME "Bibata-Modern-Ice"
    HYPRCURSOR_THEME "Bibata-Modern-Ice"
    XCURSOR_SIZE "24"
    HYPRCURSOR_SIZE "24"
    QT_QPA_PLATFORMTHEME "qt5ct"
    QT_QPA_PLATFORMTHEME_QT6 "qt6ct"
}

// config.kdl loads this file after dms/colors.kdl and later includes win,
// so only these two values override Matugen; every other colour stays DMS's.
layout {
    focus-ring {
        active-color "#cc5200"
    }
    border {
        active-color "#cc5200"
    }
}
